{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "strict": false,
    "baseUrl": ".",
    "paths": {
      "@/components/*": [
        "src/components/*"
      ],
      "@/state/*": [
        "src/state/*"
      ],
      "@/native/*": [
        "native/*"
      ],
      "@clevertree/shared": [
        "src/shared/index.ts"
      ],
      "@clevertree/shared/*": [
        "src/shared/*"
      ]
    }
  },
  "include": [
    "src",
    "native"
  ],
  "exclude": [
    "node_modules",
    "android",
    "ios"
  ]
}
